# Default: synthetic fixtures, deterministic demo provider.
PATIENT_STORE=fixtures
# Set PATIENT_STORE=sqlite to persist the synthetic seed in SQLite.
DATABASE_PATH=./data/contextcare.sqlite
# Optional server-side HTTPS AI gateway.
# Set explicitly to demo, gateway or mistral. Blank preserves the legacy gateway setting.
AI_PROVIDER=
INTRIC_API_KEY=
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
# Direct Mistral EU adapter; requires AI_PROVIDER=mistral and self-authored fixtures.
# Obtain a key in Mistral Studio and choose a model available on the EU endpoint.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
# SQLite classification is read from database metadata, not this variable.
# Organizer and unclassified databases are blocked from external transmission.
DATA_ORIGIN=
