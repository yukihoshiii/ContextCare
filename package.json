{
  "name": "umbrellaai",
  "version": "1.0.0",
  "description": "Evidence-linked synthetic patient preparation workspace",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:ai": "PATIENT_STORE=fixtures AI_PROVIDER=intric next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "data:validate": "node --import tsx scripts/validate-dataset.ts",
    "data:import:veil": "node --import tsx scripts/import-veil.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
